DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Supabase Postgres (Settings → Database → Connection pooling, transaction mode)
DATABASE_URL=postgresql://postgres.ybvmaghozvykyhtewznj:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL_REQUIRE=1
# Supabase Auth
SUPABASE_URL=https://ybvmaghozvykyhtewznj.supabase.co
SUPABASE_JWT_SECRET=
# Record / media / sharing (docs/features/13-06c-build-spec.md)
# MEDIA_STORAGE_BACKEND=supabase        # "memory" in dev (DJANGO_DEBUG=1) and tests
# SUPABASE_SERVICE_ROLE_KEY=            # server only: signs upload/playback URLs. Never expose or log it.
# SHARE_BASE_URL=https://twister.meetpawan.com
# MEDIA_MAX_BYTES=104857600
# MEDIA_PROCESSING_ENABLED=0            # 1 once the FFmpeg worker is deployed
# MEDIA_ORPHAN_HOURS=24
# UPLOAD_URL_TTL_S=3600
# PLAYBACK_URL_TTL_S=900
# REPORT_AUTOHIDE_THRESHOLD=3
# CONSENT_VERSIONS={"recording_upload":"v1"}   # JSON overrides; bump a version to force re-consent
# IP_HASH_SALT=                         # defaults to a key derived from DJANGO_SECRET_KEY
# WORKER_SHARED_SECRET=                 # HMAC key for /internal/* worker callbacks
# Opaque storage folders (spec 13 A2.5): HMAC key for the per-owner folder name. REQUIRED when
# DJANGO_DEBUG=0 (the API refuses to start without it); any long random string. Dev has a built-in default.
# Rotating it only changes folders of new uploads.
# MEDIA_PATH_SECRET=
# Media worker queue (spec 13 A2): lease the worker holds per claim, retries, limits sent to the worker
# MEDIA_JOB_LEASE_S=120
# MEDIA_JOB_MAX_TRIES=3
# MEDIA_JOB_MAX_RUN_S=900
# MEDIA_WORKER_MAX_HEIGHT=1080
# MEDIA_WORKER_URL_TTL_S=1800
# ANALYSIS_AUDIO_RETENTION_DAYS=7
# Transactional e-mail (T-3 day expiry reminders). Dev prints to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # console backend when DJANGO_DEBUG=1
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Twister <no-reply@twister.meetpawan.com>
# WEB_BASE_URL=https://twister.meetpawan.com   # links in e-mails (incl. /unsubscribe/<token>); defaults to SHARE_BASE_URL

# --- Hardening (spec 15 §2; docs/runbooks/secrets-and-rotation.md) ---
# Signed worker callbacks: X-Worker-Timestamp must be within this many seconds of the API clock.
# WORKER_SIGNATURE_MAX_SKEW_S=300
# Accept the old body-only worker signature. Leave 1 until the worker that sends X-Worker-Timestamp is
# deployed, then set 0 (docs/runbooks/deploy-and-rollback.md).
# WORKER_ALLOW_LEGACY_SIGNATURE=1
# Sentry (API): nothing starts without a DSN. PII is never sent; see twisters/observability.py.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production         # "development" when DJANGO_DEBUG=1
# SENTRY_RELEASE=                       # defaults to VERCEL_GIT_COMMIT_SHA
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Response headers (production only unless noted)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=0                 # one-way door; read hstspreload.org first
# SECURE_REFERRER_POLICY=same-origin
# API_CSP_REPORT_ONLY="default-src 'none'; frame-ancestors 'none'"   # on JSON responses; blank disables
# Round 1 (docs/features/15-round1-spec.md): score cards, account deletion/export, night owl
# API_PUBLIC_URL=https://<this-api-host>   # absolute origin used in score-card image URLs (omitted => no `images` block) and in the reminder e-mails' List-Unsubscribe URL (send_reminders refuses to run without it)
# SCORE_CARD_IMAGE_MAX_AGE_S=3600          # Cache-Control max-age of GET /public/s/{token}/image.png
# ACCOUNT_DELETION_GRACE_DAYS=30           # pending-deletion period before `purge_deleted_accounts` removes an account
# EXPORT_MAX_ATTEMPTS=20000                # attempts in GET /me/export/ (newest first); `truncated` when hit
# NIGHT_OWL_CUTOFF_HOUR=3                  # streak day boundary (local hour) for profiles with Night owl mode on
# The purge job also deletes the Supabase Auth user: needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (above).

# Round 2 (docs/features/16-round2-spec.md): Generate Twister. Turn on with the `generate_twister` flag (admin).
# GEMINI_API_KEY=                          # server only. Blank => the offline `fake` generator (canned twisters)
# GEMINI_MODEL=gemini-3.5-flash-lite       # gemini-2.5-flash returns 404 for new API keys
# GEMINI_TIMEOUT_S=20                      # per request; one retry on a 5xx or timeout
# GENERATOR_BACKEND=                       # gemini | fake; blank = gemini when a key is set, else fake
# GENERATE_DAILY_LIMIT=5                   # generations per person per UTC day
