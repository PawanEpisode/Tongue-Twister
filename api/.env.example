DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Supabase Postgres (Settings → Database → Connection pooling, transaction mode)
DATABASE_URL=postgresql://postgres.ybvmaghozvykyhtewznj:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL_REQUIRE=1
# Supabase Auth
SUPABASE_URL=https://ybvmaghozvykyhtewznj.supabase.co
SUPABASE_JWT_SECRET=
# Record / media / sharing (docs/features/13-06c-build-spec.md)
# MEDIA_STORAGE_BACKEND=supabase        # "memory" in dev (DJANGO_DEBUG=1) and tests
# SUPABASE_SERVICE_ROLE_KEY=            # server only: signs upload/playback URLs. Never expose or log it.
# SHARE_BASE_URL=https://twister.meetpawan.com
# MEDIA_MAX_BYTES=104857600
# MEDIA_PROCESSING_ENABLED=0            # 1 once the FFmpeg worker is deployed
# MEDIA_ORPHAN_HOURS=24
# UPLOAD_URL_TTL_S=3600
# PLAYBACK_URL_TTL_S=900
# REPORT_AUTOHIDE_THRESHOLD=3
# CONSENT_VERSIONS={"recording_upload":"v1"}   # JSON overrides; bump a version to force re-consent
# IP_HASH_SALT=                         # defaults to a key derived from DJANGO_SECRET_KEY
# WORKER_SHARED_SECRET=                 # HMAC key for /internal/* worker callbacks
# Opaque storage folders (spec 13 A2.5): HMAC key for the per-owner folder name. REQUIRED when
# DJANGO_DEBUG=0 (the API refuses to start without it); any long random string. Dev has a built-in default.
# Rotating it only changes folders of new uploads.
# MEDIA_PATH_SECRET=
# Media worker queue (spec 13 A2): lease the worker holds per claim, retries, limits sent to the worker
# MEDIA_JOB_LEASE_S=120
# MEDIA_JOB_MAX_TRIES=3
# MEDIA_JOB_MAX_RUN_S=900
# MEDIA_WORKER_MAX_HEIGHT=1080
# MEDIA_WORKER_URL_TTL_S=1800
# ANALYSIS_AUDIO_RETENTION_DAYS=7
# Transactional e-mail (T-3 day expiry reminders). Dev prints to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # console backend when DJANGO_DEBUG=1
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Twister <no-reply@twister.meetpawan.com>
# WEB_BASE_URL=https://twister.meetpawan.com   # links in e-mails; defaults to SHARE_BASE_URL
