VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://ybvmaghozvykyhtewznj.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Observability (spec 16, D28). Both are optional: leave a variable empty and that tool is never loaded
# and never sends anything. These are public client values (they ship in the bundle), not secrets.
# Sentry browser DSN. Error reports only, scrubbed of emails, cookies, headers and query strings.
# VITE_SENTRY_DSN=
# PostHog project API key (phc_...). Cookieless, no autocapture, no session replay, honours Do Not Track.
# VITE_POSTHOG_KEY=
# PostHog ingest host for your region: https://eu.i.posthog.com (default) or https://us.i.posthog.com.
# If you use a different host (self-hosted or a reverse proxy), add it to connect-src in vercel.json.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Dev-only click-to-source. Not bundled into the app.
# Pin which IDE opens on Option+Shift click. Omit to auto-detect the running editor.
# CODE_EDITOR=cursor
# Set to false to turn the inspector off without changing Vite config.
# CODE_INSPECTOR=false
# Hold Option/Alt+Shift and click an element to open its source. Needs the editor's
# CLI on PATH (Cursor: Cmd+Shift+P → "Shell Command: Install 'cursor' command").
# Use the cursor:// URL scheme instead of the CLI: CODE_INSPECTOR_LAUNCH=open
# CODE_INSPECTOR_LAUNCH=exec
