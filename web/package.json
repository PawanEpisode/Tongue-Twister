{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check . && tsc --noEmit && node scripts/sync-disposable-domains.mjs --check",
    "test": "vitest run",
    "build:e2e": "node scripts/build-e2e.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test --project=e2e --project=csp",
    "test:a11y": "playwright test --project=a11y",
    "e2e:install": "playwright install --with-deps chromium",
    "sync:disposable": "node scripts/sync-disposable-domains.mjs",
    "check:disposable": "node scripts/sync-disposable-domains.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "idb": "^8.0.3",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "nitro": "3.0.260610-beta",
    "onnxruntime-web": "1.30.0",
    "posthog-js": "^1.435.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tus-js-client": "^4.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
